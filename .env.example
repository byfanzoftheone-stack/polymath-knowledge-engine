PORT=3000
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/polymath_knowledge_engine
NODE_ENV=development
VITE_API_BASE_URL=
WORKER_POLL_MS=1000

# --- Monetization & governance (placeholders; real values go in .env or host secrets, never in git) ---
# Gate paid endpoints (/api/relay) behind API keys. "key:tier" pairs, tier = free|pro|team.
REQUIRE_API_KEY=false
API_KEYS=
# Owner approval switch: checkout talks to Stripe ONLY when true AND keys below are set.
CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
# Webhook -> license keys (POST /api/stripe/webhook). Signing secret from the Stripe dashboard (whsec_...), placeholder only.
STRIPE_WEBHOOK_SECRET=
# License store (hashed keys + pending-delivery outbox). REQUIRED for the webhook: with neither set, the webhook
# answers 503 and webhook-issued keys are denied (fail closed). Pick ONE:
#  1) Recommended: Postgres. Reuse the app's DATABASE_URL (same server as the waitlist; tables license_events,
#     licenses, license_outbox are created automatically). Add LICENSE_DATABASE_SSL=require if your host needs TLS.
LICENSE_DATABASE_URL=
#LICENSE_DATABASE_SSL=require
#LICENSE_DB_POOL_MAX=5
#  2) SQLite on a persistent volume (one server only, Node >= 22.5; prints an ExperimentalWarning): LICENSE_DB=/data/licenses.sqlite
#  3) Local/dev JSON file (single process): LICENSE_DB=./data/licenses.json
LICENSE_DB=
PUBLIC_APP_URL=http://localhost:3000
# Placeholder prices (USD/month), pending owner approval
PRICE_PRO_USD=19
PRICE_TEAM_USD=99
# Governance
API_RATE_LIMIT_PER_MIN=120
CORS_ORIGIN=
TRUST_PROXY=false
AUDIT_LOG_FILE=
