{
  "name": "polymath-knowledge-engine",
  "version": "1.0.0",
  "private": true,
  "description": "Curriculum-driven learning system with Node/Express backend and React/Vite frontend.",
  "scripts": {
    "bootstrap": "node scripts/bootstrap.js",
    "dev": "concurrently -k \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "nodemon backend/src/server.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "node backend/src/server.js",
    "start:prod": "cross-env NODE_ENV=production node backend/src/server.js",
    "migrate": "node backend/src/db/migrate.js",
    "migrate:reset": "node backend/src/db/migrate.js --reset",
    "seed": "node backend/src/db/seed.js",
    "test": "node --test backend/tests/**/*.test.js"
  },
  "dependencies": {
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "pg": "^8.16.3",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "supertest": "^7.1.3"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
